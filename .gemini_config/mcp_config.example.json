{
	"mcpServers": {
		"blender": {
			"command": "uvx",
			"args": [
				"blender-mcp"
			],
			"env": {
				"PYTHONIOENCODING": "utf-8",
				"PYTHONWARNINGS": "ignore",
				"BLENDER_MCP_TELEMETRY": "false"
			}
		},
		"photoshop": {
			"command": "node",
			"args": [
				"./Photoshop_Agentic/photoshop-mcp/dist/index.js"
			]
		}
	}
}
